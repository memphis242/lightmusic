// cppcheck suppressions. Prefer an inline `// cppcheck-suppress <id>` with a reason next
// to the code; list global ones here only with a reason.
//
// Vendored and fetched code is not ours to fix (also excluded with -i).
*:*/third_party/*
*:*/_deps/*
// System headers are not part of the analysis; cppcheck cannot see most of them anyway.
missingIncludeSystem
// Reported when a suppression here does not match on some cppcheck version.
unmatchedSuppression
// Tests use non-fatal CHECK(x) followed by code that assumes x (CHECK(fd >= 0); write(fd..)).
// On a failed CHECK the test is already failing; cppcheck reads the CHECK as "may be false".
invalidFunctionArg:*/tests/*
containerOutOfBounds:*/tests/*
// Single-threaded test setup.
getpwuidCalled:*/tests/*
