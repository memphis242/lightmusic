# clang-tidy: the STRICT set, for app code (libplayer, libnet, libconfig, server,
# frontends, tools, include). tests/.clang-tidy inherits this and relaxes it for tests.
# A check is disabled here only when its reason applies to app code; a check whose
# nuisance hits are test-only is disabled in tests/.clang-tidy instead (CLAUDE.md).
# AST-based checks for our code (third_party is excluded by HeaderFilterRegex
# and by .github/ci/analyze.sh, which only feeds our own translation units).
# Disabled checks are listed with the reason; keep this list short and justified.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-assignment-in-if-condition,
  -bugprone-forward-declaration-namespace,
  cert-*,
  -cert-dcl21-cpp,
  concurrency-*,
  -concurrency-mt-unsafe,
  performance-*,
  -performance-enum-size,
  -performance-inefficient-string-concatenation,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  -misc-const-correctness,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-emplace,
  modernize-redundant-void-arg,
  modernize-make-unique,
  modernize-make-shared,
  modernize-use-std-print,
  readability-container-size-empty,
  readability-redundant-string-cstr,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-smartptr-get,
  readability-delete-null-pointer,
  readability-duplicate-include,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-prefer-member-initializer
# Reasons for the exclusions above:
#  easily-swappable-parameters: flags most (int, int) signatures; API-wide noise.
#  narrowing-conversions: duplicates -Wconversion, which the compilers already enforce.
#  branch-clone: identical branches are used deliberately in parsers/state machines.
#  assignment-in-if-condition: `if ((r = sd_call(...)) < 0)` is the sd-bus/POSIX idiom;
#    -Wparentheses already catches the accidental `if (a = b)`.
#  forward-declaration-namespace: fires inside yaml-cpp's headers, not our code.
#  concurrency-mt-unsafe: flags strerror/getenv/exit/system. glibc's strerror is MT-safe
#    for valid errno values, nothing calls setenv outside single-threaded test setup,
#    and exit() is only reached before threads start. Revisit for the Windows port.
#  inefficient-string-concatenation: error-message building on cold paths.
#  cert-dcl21-cpp: deprecated advice (const return of postfix ++).
#  performance-enum-size: micro-optimisation with ABI churn.
#  optin.performance.Padding: layout advice, not a bug.
#  misc-non-private-member-variables-in-classes: plain aggregates are used on purpose.
#  misc-no-recursion: recursion is bounded (YAML depth limit, directory walk).
#  misc-include-cleaner / use-internal-linkage / const-correctness: style churn
#    without bug-finding value here (400+ / 200+ hits in app code).
# Formatted output (CLAUDE.md "Output", include/lm/print.hpp): modernize-use-std-print
# flags printf/fprintf; bugprone-unsafe-functions.CustomFunctions (below) flags the rest
# of the printf family and puts/fputs/perror, so new code uses std::format/std::print.
# Re-enabled for app code (their nuisance hits were in tests): cert-err33-c,
# bugprone-implicit-widening-of-multiplication-result, bugprone-switch-missing-default-case,
# cert-err58-cpp, misc-use-anonymous-namespace.
#
# Return values: every result is checked or explicitly discarded with (void) (CLAUDE.md).
# cert-err33-c covers the C library; bugprone-unused-return-value is widened to the
# POSIX/system, sqlite and curl calls we use (setting the option replaces the default
# list, so the check's own defaults come first: second line is ours).
# clang-tidy >= 19 treats each entry as an unanchored regex over the qualified name,
# so entries are anchored (^...$): otherwise ::close also matches ::closedir,
# ::bind matches Stmt::bind, ::std::filesystem::remove matches remove_all. -Wunused-result enforces [[nodiscard]].
CheckOptions:
  bugprone-unsafe-functions.CustomFunctions: >-
    ^::(std::)?v?snprintf$,std::format/std::format_to_n;^::(std::)?v?sprintf$,std::format/std::format_to_n;^::(std::)?(f)?puts$,std::print/lm::diag (lm/print.hpp);^::(std::)?perror$,lm::diagln(stderr ... strerror(errno));^::(std::)?v?fprintf$,std::print/lm::diag (lm/print.hpp);^::(std::)?v?printf$,std::print/lm::diag (lm/print.hpp)
  bugprone-unused-return-value.AllowCastToVoid: true
  bugprone-unused-return-value.CheckedFunctions: >-
    ^::std::async$;^::std::launder$;^::std::remove$;^::std::remove_if$;^::std::unique$;^::std::unique_ptr::release$;^::std::basic_string::empty$;^::std::vector::empty$;^::std::back_inserter$;^::std::distance$;^::std::find$;^::std::find_if$;^::std::inserter$;^::std::lower_bound$;^::std::make_pair$;^::std::map::count$;^::std::map::find$;^::std::map::lower_bound$;^::std::multimap::equal_range$;^::std::multimap::upper_bound$;^::std::set::count$;^::std::set::find$;^::std::setfill$;^::std::setprecision$;^::std::setw$;^::std::upper_bound$;^::std::vector::at$;^::bsearch$;^::ferror$;^::feof$;^::isalnum$;^::isalpha$;^::isblank$;^::iscntrl$;^::isdigit$;^::isgraph$;^::islower$;^::isprint$;^::ispunct$;^::isspace$;^::isupper$;^::iswalnum$;^::iswprint$;^::iswspace$;^::isxdigit$;^::memchr$;^::memcmp$;^::strcmp$;^::strcoll$;^::strncmp$;^::strpbrk$;^::strrchr$;^::strspn$;^::strstr$;^::wcscmp$;^::access$;^::bind$;^::connect$;^::difftime$;^::dlsym$;^::fnmatch$;^::getaddrinfo$;^::getopt$;^::htonl$;^::htons$;^::iconv_open$;^::inet_addr$;^::isascii$;^::isatty$;^::mmap$;^::newlocale$;^::openat$;^::pathconf$;^::pthread_equal$;^::pthread_getspecific$;^::pthread_mutex_trylock$;^::readdir$;^::readlink$;^::recvmsg$;^::regexec$;^::scandir$;^::semget$;^::setjmp$;^::shm_open$;^::shmget$;^::sigismember$;^::strcasecmp$;^::strsignal$;^::ttyname$;
    ^::close$;^::read$;^::write$;^::pread$;^::pwrite$;^::open$;^::openat$;^::fsync$;^::fdatasync$;^::ftruncate$;^::unlink$;^::rename$;^::renameat$;^::mkdir$;^::rmdir$;^::chmod$;^::fchmod$;^::dup$;^::dup2$;^::pipe$;^::pipe2$;^::fcntl$;^::ioctl$;^::kill$;^::waitpid$;^::sigaction$;^::sigprocmask$;^::pthread_sigmask$;^::sigemptyset$;^::sigaddset$;^::sigfillset$;^::sigwait$;^::setrlimit$;^::getrlimit$;^::tcgetattr$;^::tcsetattr$;^::poll$;^::select$;^::send$;^::recv$;^::connect$;^::bind$;^::listen$;^::shutdown$;^::setsockopt$;^::lseek$;^::fseeko$;^::ftello$;^::fflush$;^::fclose$;^::fputs$;^::fputc$;^::fwrite$;^::fread$;^::remove$;^::std::fclose$;^::std::fflush$;^::std::fwrite$;^::std::fread$;^::std::remove$;^::std::rename$;^::gmtime_r$;^::localtime_r$;^::clock_gettime$;^::nanosleep$;^::posix_spawn$;^::posix_spawnp$;^::posix_fadvise$;^::madvise$;^::mlock$;^::munmap$;^::prctl$;^::setenv$;^::unsetenv$;^::chdir$;^::access$;^::stat$;^::fstat$;^::lstat$;^::realpath$;^::sd_bus_flush$;^::sd_bus_process$;^::sd_bus_wait$;^::sd_bus_emit_properties_changed$;^::sd_bus_reply_method_return$;^::sqlite3_exec$;^::sqlite3_step$;^::sqlite3_bind_int64$;^::sqlite3_bind_text$;^::sqlite3_bind_int$;^::sqlite3_reset$;^::sqlite3_finalize$;^::sqlite3_close$;^::curl_easy_setopt$;^::curl_easy_getinfo$;^::curl_global_init$;^::std::signal$;^::signal$;^::raise$;^::std::raise$;^::std::system$;^::system$;^::atexit$;^::std::atexit$;^::std::to_chars$;^::std::from_chars$;^::std::filesystem::remove$;^::std::filesystem::create_directories$;^::std::filesystem::create_directory$
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|libplayer|libconfig|libnet|server|frontends|tools|tests)/.*'
FormatStyle: none
